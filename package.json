{
  "name": "feno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create feno-db",
    "db:migrate:local": "wrangler d1 execute feno-db --local --file=schema/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute feno-db --remote --file=schema/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
